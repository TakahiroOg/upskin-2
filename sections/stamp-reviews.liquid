{% comment %}
  Nookly: customer reviews section (new, for templates/product.eyebrow-stamp.json).
  - Summary: average rating and review count are read from the product's reviews.rating and
    reviews.rating_count metafields (the standard Shopify reviews metafields), so nothing is made up.
  - "App block": drop a reviews app (Judge.me, Loox, Shopify Product Reviews...) here to show its list / form.
  - "Review" blocks: hand-added reviews, shown as cards. Only add real customer reviews.
  Styles live in assets/stamp.css.
{% endcomment %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign rating_value = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value
  assign review_blocks = section.blocks | where: 'type', 'review'
  assign other_blocks = section.blocks | where: 'type', '@app'
-%}

<div id="reviews" class="stamp-reviews section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="stamp-reviews__heading inline-richtext {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if rating_value != blank -%}
      <div class="stamp-reviews__summary">
        <div class="stamp-reviews__score">
          <span class="stamp-reviews__avg">{{ rating_value.rating }}</span>
          <div>
            <div
              class="stamp-stars"
              role="img"
              aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: rating_value.rating, rating_max: rating_value.scale_max }}"
              style="--stamp-rating: {{ rating_value.rating }};"
            ></div>
            <p class="stamp-reviews__count">
              {%- if rating_count != blank -%}
                {{ section.settings.count_text | replace: '[count]', rating_count }}
              {%- endif -%}
            </p>
          </div>
        </div>
        {%- if section.settings.button_label != blank -%}
          <a
            {% if section.settings.button_link != blank %}
              href="{{ section.settings.button_link }}"
            {% else %}
              role="link" aria-disabled="true"
            {% endif %}
            class="button button--secondary stamp-reviews__button"
          >
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- for block in other_blocks -%}
      <div class="stamp-reviews__app" {{ block.shopify_attributes }}>
        {% render block %}
      </div>
    {%- endfor -%}

    {%- if review_blocks.size > 0 -%}
      <ul class="stamp-reviews__list" role="list">
        {%- for block in review_blocks -%}
          {%- if block.settings.text != blank -%}
            <li class="stamp-review" {{ block.shopify_attributes }}>
              <div class="stamp-review__top">
                <div
                  class="stamp-stars"
                  role="img"
                  aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: block.settings.rating, rating_max: 5 }}"
                  style="--stamp-rating: {{ block.settings.rating }};"
                ></div>
                {%- if block.settings.verified -%}
                  <span class="stamp-review__verified">{{ section.settings.verified_text | escape }}</span>
                {%- endif -%}
              </div>
              {%- if block.settings.title != blank -%}
                <h3 class="stamp-review__title h4">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              <div class="stamp-review__body rte">{{ block.settings.text }}</div>
              <div class="stamp-review__footer">
                {%- if block.settings.image != blank -%}
                  <div class="stamp-review__photo">
                    {{
                      block.settings.image
                      | image_url: width: 240
                      | image_tag: widths: '120, 240', sizes: '72px', loading: 'lazy', alt: block.settings.author
                    }}
                  </div>
                {%- endif -%}
                {%- if block.settings.author != blank -%}
                  <p class="stamp-review__author">{{ block.settings.author | escape }}</p>
                {%- endif -%}
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- elsif rating_value == blank and other_blocks.size == 0 and request.design_mode -%}
      <p class="stamp-reviews__empty">
        Add a reviews app block, or Review blocks with real customer reviews. The rating summary appears
        automatically once the product has a reviews.rating metafield.
      </p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Stamp reviews",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Review",
          "info": "Use a real customer review only. Reviews with empty text are hidden."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Customer name"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Show verified badge",
          "default": false,
          "info": "Only tick this if you confirmed the customer bought the product."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Customer photo"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "What Our Customers Say"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h1", "label": "Large" },
        { "value": "h2", "label": "Medium" }
      ],
      "default": "h2"
    },
    {
      "type": "text",
      "id": "count_text",
      "label": "Review count text",
      "default": "Based on [count] reviews"
    },
    {
      "type": "text",
      "id": "verified_text",
      "label": "Verified badge text",
      "default": "Verified"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Write a review"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-stamp-cream"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 52
    }
  ],
  "presets": [
    {
      "name": "Stamp reviews"
    }
  ]
}
{% endschema %}
