{% comment %}
  Nookly: accordions in side-by-side columns (new, for templates/product.facelift-device.json).
  Add a "Column heading" block to start a column, then "Row" blocks (question + answer) to fill it.
  Uses the theme's accordion styles (component-accordion.css) plus assets/facelift.css.
{% endcomment %}

{{ 'component-accordion.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="facelift-acc section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="facelift-acc__grid">
      {%- assign column_open = false -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'group' -%}
          {%- if column_open -%}
            {{ '</div>' }}
          {%- endif -%}
          {%- assign column_open = true -%}
          {{ '<div class="facelift-acc__col" ' }}{{ block.shopify_attributes }}{{ '>' }}
          {%- if block.settings.heading != blank -%}
            <p class="facelift-acc__eyebrow">{{ block.settings.heading | escape }}</p>
          {%- endif -%}
        {%- else -%}
          {%- unless column_open -%}
            {%- assign column_open = true -%}
            {{ '<div class="facelift-acc__col">' }}
          {%- endunless -%}
          <div class="facelift-acc__row accordion" {{ block.shopify_attributes }}>
            <details id="Details-{{ block.id }}-{{ section.id }}"{% if block.settings.open %} open{% endif %}>
              <summary>
                <h3 class="facelift-acc__title accordion__title inline-richtext">
                  {{- block.settings.heading | default: block.settings.page.title | escape -}}
                </h3>
                <span class="facelift-acc__icon" aria-hidden="true"></span>
              </summary>
              <div class="accordion__content rte" id="FaceliftAccordion-{{ block.id }}-{{ section.id }}">
                {{ block.settings.content }}
                {{ block.settings.page.content }}
              </div>
            </details>
          </div>
        {%- endif -%}
      {%- endfor -%}
      {%- if column_open -%}
        {{ '</div>' }}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Facelift accordion",
  "tag": "section",
  "class": "section",
  "blocks": [
    {
      "type": "group",
      "name": "Column heading",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Product details"
        }
      ]
    },
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Question or title"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Answer or details.</p>"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Content from a page",
          "info": "Optional. Shown after the content above."
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-facelift-white"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 52
    }
  ],
  "presets": [
    {
      "name": "Facelift accordion",
      "blocks": [
        { "type": "group" },
        { "type": "row" },
        { "type": "group", "settings": { "heading": "Questions" } },
        { "type": "row" }
      ]
    }
  ]
}
{% endschema %}
